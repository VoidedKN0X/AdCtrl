<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by default; values-night/themes.xml switches to the dark Signal look with the device. -->
    <style name="Theme.AdCtrl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- The Quick Settings tile's pause dialog (shown by System UI over the panel), following the device's dark or light mode. -->
    <style name="Theme.AdCtrl.TileDialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert" />
</resources>
