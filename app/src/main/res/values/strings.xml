    <!-- Server setup -->
    <string name="setup_title">Add your AdGuard Home</string>
    <string name="setup_intro">Enter the address you open AdGuard Home\'s web interface on, and the username and password you sign in with there.</string>
    <string name="add_server">Add server</string>
    <string name="edit_server_title">Change server</string>
    <string name="field_address">Address</string>
    <string name="field_address_hint">adguard.example.com or 192.168.1.2:3000</string>
    <string name="address_resolves">Connects to %1$s, and only to this address</string>
    <string name="address_only_this">Without http://, AdCtrl uses HTTPS. AdCtrl only ever connects to the address you enter here.</string>
    <string name="address_invalid">That doesn\'t look like a web address.</string>
    <string name="address_http_public">Plain http:// is only allowed for addresses on your own network (like 192.168.x.x or adguard.lan), because AdGuard Home sends your password with every request. Use https:// for this address.</string>
    <string name="field_name">Name (optional)</string>
    <string name="field_name_hint">Defaults to the address, like \"Primary\" or \"Secondary\"</string>
    <string name="field_username">Username</string>
    <string name="field_password">Password</string>
    <string name="show_password">Show password</string>
    <string name="hide_password">Hide password</string>
    <string name="password_reenter">Enter the password again: it\'s only reused for the same address and username.</string>
    <string name="http_switch">Allow plain HTTP for this server</string>
    <string name="http_switch_subtitle">Your password and query log travel unencrypted on your network</string>
    <string name="http_switch_footer">Only for addresses on your own network. A name like adguard.lan must also point to a private address, or AdCtrl won\'t connect. HTTPS is safer: see the README\'s recommended setup.</string>
    <string name="http_warning_title">Use plain HTTP?</string>
    <string name="http_warning_body">AdCtrl will talk to %1$s without encryption. AdGuard Home sends your username and password with every request, and the query log shows what everyone on your network visits, so anyone who can watch your network can read both. Only do this on a network you trust.</string>
