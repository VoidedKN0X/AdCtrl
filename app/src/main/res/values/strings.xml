    <!-- Connection problems -->
    <string name="connection_problem">Connection problem</string>
    <string name="check_again">Check again</string>
    <string name="sign_in_again">Sign in again</string>
    <string name="error_unreachable">Can\'t reach %1$s. Check the address and that your phone is on a network that can reach it.</string>
    <string name="error_untrusted_cert">The certificate of %1$s isn\'t trusted.</string>
    <string name="error_pin_mismatch">%1$s presents a different certificate from the one you trusted. AdCtrl stopped connecting to protect your password.</string>
    <string name="error_bad_login">Wrong username or password. After several wrong passwords (5 by default), AdGuard Home blocks sign-ins from your address for a while (15 minutes by default), even with the right password.</string>
    <string name="error_forbidden">AdGuard Home refused this request.</string>
    <string name="error_not_adguard">%1$s answered, but not like AdGuard Home. Check the address and port: it\'s the one you open AdGuard Home\'s web interface on.</string>
    <string name="error_redirect">%1$s answered with a redirect. AdCtrl never follows redirects, so enter the address AdGuard Home actually runs on (often its https:// address).</string>
    <string name="error_redirect_to">%1$s redirects to %2$s. AdCtrl never follows redirects, so enter that address instead (often the https:// one).</string>
    <string name="error_too_old">This server runs AdGuard Home %1$s. AdCtrl needs %2$s or newer: update AdGuard Home, then tap Retry.</string>
    <string name="error_cleartext">AdCtrl won\'t use plain HTTP for %1$s: it\'s only allowed for addresses on your own network, with the server\'s HTTP switch on.</string>
    <string name="error_blocked_host">AdCtrl only connects to the servers you added, so this request wasn\'t sent.</string>
    <string name="error_server">AdGuard Home returned an error (%1$d).</string>
    <string name="error_with_detail">%1$s\n\n%2$s</string>
    <string name="error_generic">Something went wrong.</string>
