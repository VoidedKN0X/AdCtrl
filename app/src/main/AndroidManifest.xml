<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to your own AdGuard Home servers (and nothing else). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fingerprint unlock for the app lock (framework BiometricManager/BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Notifications from the background checks; asked for only when you turn them on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Hides other apps' floating windows over the lock screen, PIN screens and confirmations (only while they
         show). Granted at install, no prompt. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- WorkManager adds the foreground-service permission for long jobs shown as a notification. The background
         checks and widget refreshes are short jobs that never run as a foreground service, so it's removed (with
         WorkManager's foreground service below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- ntfy, the only push app AdCtrl uses (UnifiedPush), to wake the background check. -->
    <queries>
        <package android:name="io.heckel.ntfy" />
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application
        android:name=".AdCtrlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:intentMatchingFlags="enforceIntentFilter"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdCtrl">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The launcher shortcuts (res/xml/shortcuts.xml). Declared so they keep working with strict intent
                 matching (intentMatchingFlags): other apps' intents must match a filter here. -->
            <intent-filter>
                <action android:name="com.vknxworks.adctrl.PAUSE" />
                <action android:name="com.vknxworks.adctrl.QUERIES" />
                <action android:name="com.vknxworks.adctrl.SEARCH" />
                <action android:name="com.vknxworks.adctrl.BLOCKED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile opens AdCtrl. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Push from ntfy: the push address and wake-up messages. Exported because ntfy is another app;
             every broadcast must carry the secret token of AdCtrl's registration or it's ignored. A message
             only starts the background check; its content is never used. -->
        <receiver
            android:name=".data.notify.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
        <!-- ntfy binds to this for a few seconds before delivering a message, so AdCtrl can check at once.
             It does nothing else. -->
        <service
            android:name=".data.notify.RaiseToForegroundService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>

        <!-- Home screen widget: protection state with a pause countdown, and the last 24 hours. -->
        <receiver
            android:name=".ui.widgets.ProtectionWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_protection_info" />
        </receiver>

        <!-- Quick Settings tile: protection on, paused or off; tap to pause or resume. Exported because
             only System UI can bind to it (BIND_QUICK_SETTINGS_TILE). -->
        <service
            android:name=".ui.widgets.ProtectionTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_shield"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- WorkManager's diagnostics receiver (debug dumps over adb) isn't needed; leave it out. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <!-- AndroidX's profile installer receiver lets other apps ask AdCtrl to write or skip its
             ART profile; it isn't needed, so leave it out. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- WorkManager's foreground service, for long jobs shown as a notification. AdCtrl never uses it. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- Don't let androidx.emoji2 look up a downloadable emoji font at start-up: emoji are drawn with the
             phone's own emoji font, and nothing is fetched. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
